Option Compare Database
Option Explicit

' A question's or an exam's history (Build_dlgHistory). OpenArgs
' "key=<QuestionKey>": every version's audit rows, newest first
' (HistorySql): who wrote, changed, submitted, approved, rejected and
' retired it, and when; the circle is the first version's author. Or
' "exam=<ExamID>": the exam's rows (modExamApprovals.ExamHistorySql): who
' generated, signed off, approved, sent back and downloaded it; the circle
' is who generated it. Copy puts it on the clipboard as text.
'
' Owner: the question bank (build phase 5); exams' history from build phase
' 8. Depends on: modAdmin, modErrors, modExamApprovals, modQuestions, modUI;
' the kit's modKitUI, modKitUtil, modPersonnel.

Private m_key As Long           ' the question's key (0 for an exam)
Private m_exam As Long          ' the exam (0 for a question)

Public Property Get HelpTopic() As String
    HelpTopic = IIf(m_exam <> 0, "exams.history", "questions.history")
End Property

Private Sub Form_Load()
    Dim rs As DAO.Recordset, n As Long, nVer As Long, st As String
    On Error GoTo Err_Handler
    m_exam = OpenArgLong(Me, "exam")
    If m_exam <> 0 Then
        LoadExam
        CenterOnApp Me
        Exit Sub
    End If
    m_key = OpenArgLong(Me, "key")
    Me.Caption = "History of Q" & m_key
    Me.lblHead.Caption = "History of Q" & m_key
    Me.sfHist.Form.RecordSource = HistorySql(m_key)
    n = Me.sfHist.Form.RecordsetClone.RecordCount
    nVer = DCount("*", "tblQuestions", "QuestionKey=" & m_key)
    Set rs = CurrentDb.OpenRecordset("SELECT TOP 1 q.VersionNo, q.StatusID, " & PersonNameSql() & " AS author " & _
        "FROM tblQuestions AS q LEFT JOIN " & PERSON_TABLE & " AS p ON q.AuthorPersonID=p.person_id " & _
        "WHERE q.QuestionKey=" & m_key & " ORDER BY q.VersionNo", dbOpenSnapshot)
    If Not rs.EOF Then Me.txtAuthor = rs!author
    rs.Close
    st = Nz(DLookup("StatusID", "tblQuestions", "QuestionKey=" & m_key & " AND IsCurrent"), 0)
    Me.lblSub.Caption = "Written by " & Nz(Me.txtAuthor, "someone no longer listed") & ". " & nVer & IIf(nVer = 1, " version", " versions") & _
        IIf(Val(st) <> 0, "; the current one is " & LCase$(QStatusName(Val(st))) & ".", ".")
    SetVisible Me.sfHist, n > 0
    SetEnabled Me.btnCopy, n > 0
    CenterOnApp Me
    Exit Sub
Err_Handler:
    HandleError "dlgHistory.Form_Load", Nz(Me.OpenArgs, "")
End Sub

' The exam's rows, and who it is for and where it stands.
Private Sub LoadExam()
    Dim rs As DAO.Recordset, n As Long, ref As String, st As String
    Set rs = CurrentDb.OpenRecordset("SELECT e.VersionNo, e.RecipientName, e.StatusID, " & PersonNameSql() & " AS maker " & _
        "FROM tblExams AS e LEFT JOIN " & PERSON_TABLE & " AS p ON e.CreatedByPersonID=p.person_id WHERE e.ExamID=" & m_exam, dbOpenSnapshot)
    If Not rs.EOF Then
        ref = ExamRef(m_exam, rs!VersionNo)
        Me.txtAuthor = rs!maker
        Select Case ExamStatusName(rs!StatusID)
            Case ES_SME_REVIEW: st = "in SME review"
            Case ES_REVIEW: st = "waiting on an approver"
            Case ES_APPROVED: st = "approved"
            Case ES_REJECTED: st = "sent back to its SMEs"
            Case Else: st = "in no known state"
        End Select
        Me.lblSub.Caption = "For " & rs!RecipientName & ", generated by " & Nz(rs!maker, "someone no longer listed") & ". It is " & st & "."
    Else
        ref = "E" & m_exam
    End If
    rs.Close
    Me.Caption = "History of " & ref
    Me.lblHead.Caption = "History of " & ref
    Me.sfHist.Form.RecordSource = ExamHistorySql(m_exam)
    n = Me.sfHist.Form.RecordsetClone.RecordCount
    SetVisible Me.sfHist, n > 0
    SetEnabled Me.btnCopy, n > 0
End Sub

' A row clicked (subGrid): nothing more to show than the row itself.
Public Sub GridClick(ByVal grid As String, ByVal dbl As Boolean)
End Sub

Private Sub btnCopy_Click()
    Dim s As String
    On Error GoTo Err_Handler
    If m_exam <> 0 Then s = ExamHistoryText(m_exam) Else s = HistoryText(m_key)
    If KitCopyText(s) Then KitToast "History copied.", "success"
    Exit Sub
Err_Handler:
    HandleError "dlgHistory.btnCopy_Click", Nz(Me.OpenArgs, "")
End Sub

Private Sub btnClose_Click()
    On Error GoTo Err_Handler
    DoCmd.Close acForm, Me.Name, acSaveNo
    Exit Sub
Err_Handler:
    HandleError "dlgHistory.btnClose_Click"
End Sub
